<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.apple-tv-movies</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/ABSOLUTE/PATH/TO/REPO/mac/publish.zsh</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/apple-tv-movies.out.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/apple-tv-movies.err.log</string>
</dict>
</plist>
